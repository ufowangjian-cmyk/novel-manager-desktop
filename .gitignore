# 运行时数据 —— 不要提交/分享这些
# 用 data/* 而非 data/，才能用 ! 放行个别文件（目录被整体忽略后 git 不会再进入）
data/*
!data/.gitkeep
# 表情映射是纯数据（表情名 → emoji），无隐私，放行以便新用户开箱可用
!data/emoji_mapping.json

# 日志
*.log
data/*.log

# 缓存的扫描结果（体积大，可重建）
data/novel_cache.json
data/*.bak

# 阅读记录与个人配置
data/reading_records.json
data/config.json
data/secret_key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/

# ========== 版权受限素材 ==========
# 表情包：2026-10-23 起开放随仓库分发（多为网络流传的表情图，GitHub 上同类资源常见，
# 约 4.7MB / 279 个文件）；系统缩略图 Thumbs.db 由上方「系统垃圾」规则排除。
# 头图背景来源网络、授权不明，仍不随仓库分发；缺了不影响功能
# 图标与 svg 素材可公开
static/images/header-bg-*.webp

# 本地备份（含真实路径与原始文件）
_local_backup/

# 中文名启动脚本不入库（跨系统文件名编码易出问题），
# 仓库内提供等价的 start_emoji_editor.bat
启动表情映射编辑器.bat

# ========== 本地凭据 ==========
# 临时 token 文件，绝不提交
.pat
*.pat
*.token

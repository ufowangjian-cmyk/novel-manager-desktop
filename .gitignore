data/*.bak

# 阅读记录与个人配置
data/reading_records.json
data/config.json
data/secret_key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/

